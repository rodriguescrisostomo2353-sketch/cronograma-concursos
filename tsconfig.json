{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*", "./src/*"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*", "components/**/*", "demo.tsx"],
  "exclude": ["node_modules", "dist", "lixo", "backend-csharp", "www"]
}
